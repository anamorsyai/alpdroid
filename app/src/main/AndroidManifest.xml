<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!-- Keeps this process foreground-priority while a long CLI operation (an agent run, a
         build) is in progress, so it survives backgrounding instead of the OS killing it —
         see TerminalKeepAliveService. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Self-update: hand the downloaded APK to the system installer (user confirms there). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Legacy scoped-storage fallback for API 24-29; superseded on 30+ by the
         MANAGE_EXTERNAL_STORAGE grant requested at runtime from Settings (StorageAccess.kt). -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:name=".AlpineTermApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.AlpDroid"
        android:requestLegacyExternalStorage="true">
        <!-- API 29 specifically opts into scoped storage even with WRITE_EXTERNAL_STORAGE
             granted, unless this flag turns it back off — without it, /sdcard could bind-mount
             into the guest but not actually be fully readable/writable there on that one API
             level. Ignored (a no-op) on API 30+, where MANAGE_EXTERNAL_STORAGE is the real grant. -->

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.App.Starting"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".AlpineWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_alpdroid_info" />
        </receiver>

        <service
            android:name=".TerminalKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps interactive Alpine Linux shells and long-running CLI processes (builds, coding agents) alive in the background" />
        </service>

        <!-- Exposes files under both roots (Android shared storage, the Alpine rootfs) as
             content:// URIs for Open-with/Share targets — file:// URIs to another app's process
             have been blocked (FileUriExposedException) since API 24, MANAGE_EXTERNAL_STORAGE
             or not. See res/xml/file_paths.xml for which directories this actually covers. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>

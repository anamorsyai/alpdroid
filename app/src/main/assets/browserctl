#!/bin/sh
# browserctl — drive AlpBrowser from the AlpDroid agent's Alpine shell (control API on 127.0.0.1, reachable from proot).
# AlpDroid installs this and provisions the token automatically (read from AlpBrowser over a signed channel), so you
# normally just run `browserctl ping`. If the token isn't set yet, open the AlpBrowser app once and retry.
#
# General:   ping | ca | trust | mode [bugbounty|webdev] | navigate <url> | eval '<js>' | clear [cookies|cache|storage|all]
# History:   history [host] | get <id>
# Bug bounty: scope [<pattern> ...] | intercept on|off [hostFilter] | pending | resolve <holdId> [forward|drop]
#             rule add <REQ_HEADER|REQ_BODY|RES_HEADER|RES_BODY> <find> <replace> [host] | rules | rule del <id>
# Web dev:   console [limit]
#
# Every command's real exit status reflects whether the HTTP call actually succeeded — never trust a printed
# "ok"-looking message over the exit code (`echo $?` after any command, or `browserctl ping || echo unreachable`).

# Token/port come from AlpBrowser via AlpDroid; this env file is refreshed on every session start.
[ -z "$ALPBROWSER_TOKEN" ] && [ -f /etc/alpdroid/alpbrowser.env ] && . /etc/alpdroid/alpbrowser.env

BASE="http://127.0.0.1:${ALPBROWSER_PORT:-8899}/v1"
TOK="${ALPBROWSER_TOKEN:-}"
if [ -z "$TOK" ]; then
  echo "AlpBrowser is not linked yet. Install it from AlpDroid → Settings → About → AlpBrowser and open it once, then retry." >&2
  exit 3
fi
H="Authorization: Bearer $TOK"
# wget's own exit status is preserved and returned (the trailing `echo` for a readable trailing newline would
# otherwise reset $? to 0 on every call, silently turning every failed request into an apparent success).
get() {
  wget -qO- --header "$H" "$BASE$1"
  st=$?
  echo
  return $st
}
post() {
  wget -qO- --header "$H" --header "Content-Type: application/json" --post-data "$2" "$BASE$1"
  st=$?
  echo
  return $st
}
jstr() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/^/"/; s/$/"/'; }
case "$1" in
  ping)      get "/ping" ;;
  ca)        raw=$(get "/ca") || { echo "error: could not reach AlpBrowser (is it open? try: browserctl ping)" >&2; exit 1; }
             printf '%s' "$raw" | sed -n 's/.*"pem":"\(.*\)".*/\1/p' | sed 's/\\n/\n/g' ;;
  trust)     pem=$(browserctl ca) || { echo "error: could not fetch the proxy CA — AlpBrowser may not be reachable" >&2; exit 1; }
             case "$pem" in
               *"BEGIN CERTIFICATE"*) ;;
               *) echo "error: AlpBrowser did not return a CA certificate — nothing was appended" >&2; exit 1 ;;
             esac
             printf '%s\n' "$pem" >> /etc/ssl/certs/ca-certificates.crt && echo "CA appended to Alpine bundle" ;;
  mode)      if [ -n "$2" ]; then post "/mode" "{\"mode\":\"$2\"}"; else get "/mode"; fi ;;
  navigate)  post "/navigate" "{\"url\":\"$2\"}" ;;
  eval)      post "/eval" "{\"js\":$(jstr "$2")}" ;;
  clear)     post "/clear" "{\"what\":\"${2:-all}\"}" ;;
  history)   if [ -n "$2" ]; then get "/history?host=$2"; else get "/history"; fi ;;
  get)       get "/history/$2" ;;
  scope)     if [ -n "$2" ]; then P=""; shift; for p in "$@"; do P="$P$(jstr "$p"),"; done; post "/scope" "{\"patterns\":[${P%,}]}"; else get "/scope"; fi ;;
  intercept) post "/intercept" "{\"enabled\":$([ "$2" = on ] && echo true || echo false),\"hostFilter\":\"${3:-}\"}" ;;
  pending)   get "/intercept" ;;
  resolve)   post "/intercept/resolve" "{\"holdId\":\"$2\",\"action\":\"${3:-forward}\"}" ;;
  rule)      case "$2" in
               add) post "/rules" "{\"part\":\"$3\",\"find\":$(jstr "$4"),\"replace\":$(jstr "$5"),\"hostContains\":\"${6:-}\"}" ;;
               del) post "/rules/delete" "{\"id\":\"$3\"}" ;;
               *)   echo "usage: browserctl rule add <PART> <find> <replace> [host] | rule del <id>" >&2; exit 2 ;;
             esac ;;
  rules)     get "/rules" ;;
  console)   get "/console?limit=${2:-200}" ;;
  *) echo "usage: browserctl {ping|ca|trust|mode|navigate|eval|clear|history|get|scope|intercept|pending|resolve|rule|rules|console}" >&2; exit 2 ;;
esac

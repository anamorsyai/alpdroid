#!/bin/sh
# browserctl — drive AlpBrowser from the AlpDroid agent's Alpine shell (control API on 127.0.0.1, reachable from proot).
# AlpDroid installs this. No token is needed on this phone (AlpBrowser's "Open local access", on by default); if that is
# switched off, AlpDroid provides the token automatically. Just run `browserctl ping`; if it cannot connect, open the
# AlpBrowser app once, then start a new shell (or retry).
#
# General:   ping | ca | trust | mode [bugbounty|webdev] | clear [cookies|cache|storage|all]
# Page:      navigate <url> [--wait] [--state load|domcontentloaded|networkidle] [--timeout ms]
#            eval '<js>' | eval --file <path> | eval --stdin   [--await] [--timeout ms]
#            click <sel> | fill <sel> <text> | type <sel> <text> [--delay ms] | press <key> | text <sel> | attr <sel> <name>
#            exists <sel> | html [sel] | waitfor <sel> [--state visible|hidden|attached] | waitnav [--state ...]   (each takes --timeout ms)
#            shot [--selector css] [--full-page] [--out path] [--format png|jpeg]
#            cookies [--domain d] | setcookie <name> <value> [--domain d] [--path p] [--secure] [--httponly] [--samesite Lax|Strict|None] [--expires epoch] [--max-age s]
#            cdp [port] | cdp off | cdp --json     remote debugging for Puppeteer/Playwright (prints the WebSocket URL)
# Capture:   capture [on|off]     route the page through the proxy (needed for decrypted History); off = fast direct browsing
# Tabs:      tabs | tab new [url] | tab switch <id> | tab close <id>
# Sockets:   frames <id> [--from n] [--limit n] [--compact]    the frames of a WebSocket, or the events of an event stream, from History
# History:   history [host] [--host h] [--method M] [--status N] [--since ISO] [--limit n] [--page n] [--compact] | get <id>
#            save <id> --dir <dir> | save <id> --out <file>      raw request/response with decoded bodies, saved to disk
#            har [--out file] [history filters]                  all captured traffic as HAR 1.2
# Bug bounty: scope [<pattern> ...] | intercept on [hostFilter] [--responses] [--all-assets] | intercept off | pending | resolve <holdId> [forward|drop]
#             resolve <holdId> edit [--method M] [--target PATH] [--status N] [--header 'Name: v']... [--body TEXT]
#             rule add <REQ_HEADER|REQ_BODY|RES_HEADER|RES_BODY> <find> <replace> [host] | rules | rule del <id>
#             rule header <req|res> 'Name: value' [host]      set/add a header on all matching traffic
# Repeater:  resend <METHOD> <url> [--header 'Name: v']... [--body TEXT]   re-send a request, print the response
# Web dev:   console [limit]
#
# Every command's real exit status reflects whether the HTTP call actually succeeded — never trust a printed
# "ok"-looking message over the exit code (`browserctl ping || echo unreachable`).

# ---- connection details --------------------------------------------------------------------------------------
# The token/port come from AlpBrowser via AlpDroid, in a file refreshed on every session start. It is PARSED, never
# sourced: the file lives in the guest where any program can write it, and sourcing it would run whatever it holds.
ENVFILE="${BROWSERCTL_ENV:-/etc/alpdroid/alpbrowser.env}"
if [ -z "${ALPBROWSER_TOKEN:-}" ] && [ -r "$ENVFILE" ]; then
  while IFS='=' read -r k v; do
    case "$k" in
      ALPBROWSER_TOKEN) ALPBROWSER_TOKEN=$v ;;
      ALPBROWSER_PORT)  [ -z "${ALPBROWSER_PORT:-}" ] && ALPBROWSER_PORT=$v ;;
    esac
  done < "$ENVFILE"
fi
TOK="${ALPBROWSER_TOKEN:-}"
PORT="${ALPBROWSER_PORT:-8899}"
# No token is needed on this phone (AlpBrowser's "Open local access", on by default); a token, when one is known, is
# still sent so it also works with that setting off. Only a plain token and a plain port ever reach a URL or header.
case "$TOK" in *[!A-Za-z0-9]*) echo "browserctl: the AlpBrowser token looks malformed" >&2; exit 3 ;; esac
case "$PORT" in ''|*[!0-9]*) echo "browserctl: the AlpBrowser port looks malformed" >&2; exit 3 ;; esac
BASE="http://127.0.0.1:$PORT/v1"
if [ -n "$TOK" ]; then H="Authorization: Bearer $TOK"; else H="X-Client: browserctl"; fi

die() { echo "browserctl: $*" >&2; exit 2; }

# wget's own complaint (for example "server returned error: HTTP/1.1 500") is kept for the failure message below.
ERRF="${TMPDIR:-/tmp}/browserctl.$$.err"
trap 'rm -f -- "${ERRF:?}"' EXIT

# ---- HTTP ----------------------------------------------------------------------------------------------------
# wget's own exit status is preserved and returned (the trailing `echo` that gives a readable trailing newline
# would otherwise reset $? to 0 on every call, silently turning every failed request into an apparent success).
# Says what is actually wrong: if AlpBrowser answers a ping it IS running, so the failure was this request (rejected or timed out).
fail_hint() {
  if wget -qO- -T 5 --header "$H" "$BASE/ping" >/dev/null 2>&1; then
    why=$(tail -n 1 "$ERRF" 2>/dev/null)
    echo "browserctl: the request failed (exit $1) although AlpBrowser is running: it was rejected or took too long${why:+ (wget: $why)}. Wait for the page (browserctl waitnav) and retry." >&2
  else
    echo "browserctl: no usable answer from AlpBrowser (exit $1): it may be closed, or it requires the control token (Open local access is off) — open it once, then try: browserctl ping" >&2
  fi
}
get() {
  wget -qO- --header "$H" "$BASE$1" 2>"$ERRF"
  st=$?
  [ $st -eq 0 ] && echo || fail_hint $st
  return $st
}
post() {
  wget -qO- --header "$H" --header "Content-Type: application/json" --post-data "$2" "$BASE$1" 2>"$ERRF"
  st=$?
  [ $st -eq 0 ] && echo || fail_hint $st
  return $st
}

# ---- JSON ----------------------------------------------------------------------------------------------------
# A JSON string literal for ANY text — empty, multi-line, with tabs, quotes or backslashes. The whole input is
# slurped into one pattern space first, so a newline becomes \n instead of closing and reopening the string.
# `$!N` (append the next line only when there IS one) matters: a bare `N` on the last line makes busybox sed quit
# without running the substitutions, so every single-line argument came out unquoted and unescaped.
TAB=$(printf '\t')
CR=$(printf '\r')
jstr() {
  [ -z "$1" ] && { printf '""'; return; }
  printf '%s' "$1" | tr -d '\000-\010\013\014\016-\037' | sed -e ':a' -e '$!N' -e '$!ba' \
    -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e "s/$TAB/\\\\t/g" -e "s/$CR/\\\\r/g" -e 's/\n/\\n/g' \
    -e 's/^/"/' -e 's/$/"/'
}

# ---- CA ------------------------------------------------------------------------------------------------------
# The control API returns the PEM inside a JSON string. Android's org.json escapes EVERY "/" as "\/" (and base64
# is full of them), so undo "\/" as well as "\n" — leaving "\/" in would silently corrupt the certificate.
ca_pem() {
  raw=$(wget -qO- --header "$H" "$BASE/ca" 2>"$ERRF") || return 1
  printf '%s' "$raw" | sed -n 's/.*"pem":"\([^"]*\)".*/\1/p' | sed -e 's#\\/#/#g' -e 's/\\n/\
/g'
}
# A structurally sound PEM certificate and nothing else: BEGIN/END markers and base64 lines in between.
valid_pem() {
  case "$1" in *"-----BEGIN CERTIFICATE-----"*"-----END CERTIFICATE-----"*) ;; *) return 1 ;; esac
  printf '%s\n' "$1" | grep -v -e '^-----BEGIN CERTIFICATE-----$' -e '^-----END CERTIFICATE-----$' -e '^[A-Za-z0-9+/=]*$' >/dev/null && return 1
  return 0
}
BUNDLE="${BROWSERCTL_BUNDLE:-/etc/ssl/certs/ca-certificates.crt}"
CADIR="${BROWSERCTL_CADIR:-/usr/local/share/ca-certificates}"
trust_ca() {
  pem=$(ca_pem) || die "could not fetch the proxy CA — AlpBrowser may not be reachable (try: browserctl ping)"
  valid_pem "$pem" || die "AlpBrowser did not return a valid CA certificate — nothing was changed"
  if command -v update-ca-certificates >/dev/null 2>&1; then
    # The proper route: survives `apk upgrade ca-certificates`, which regenerates the bundle and would drop an appended cert.
    mkdir -p "$CADIR" || die "cannot create $CADIR"
    printf '%s\n' "$pem" > "$CADIR/alpbrowser.crt" || die "cannot write the CA file"
    update-ca-certificates >/dev/null 2>&1 || die "update-ca-certificates failed"
    echo "CA installed (update-ca-certificates)"
    return 0
  fi
  # Minimal Alpine (no update-ca-certificates): append to the bundle, once. Already present = nothing to do.
  first=$(printf '%s\n' "$pem" | sed -n '2p')
  if [ -f "$BUNDLE" ] && grep -qxF -- "$first" "$BUNDLE" 2>/dev/null; then
    echo "CA already trusted"
    return 0
  fi
  printf '%s\n' "$pem" >> "$BUNDLE" || die "cannot write $BUNDLE"
  echo "CA appended to the Alpine bundle"
}

# ---- automation helpers -------------------------------------------------------------------------------------
num() { case "$1" in ''|*[!0-9]*) die "'$1' is not a number" ;; esac; }
# Percent-encode every byte: safe for any selector or value in a query string.
urlenc() { printf '%s' "$1" | LC_ALL=C od -An -tx1 | tr ' ' '%' | tr -d '\n'; }
# Like post(), but for commands that report their own failure: an {"ok":false,...} answer is printed on stderr and the
# exit status is 1, so a failed click or a timed-out wait can never look like success.
auto() {
  out=$(wget -qO- --header "$H" --header "Content-Type: application/json" --post-data "$2" "$BASE$1" 2>"$ERRF")
  st=$?
  [ $st -eq 0 ] || { fail_hint $st; return $st; }
  case "$out" in '{"ok":false'*) printf '%s\n' "$out" >&2; return 1 ;; esac
  printf '%s\n' "$out"
}
# The same, with the request body in a file (a script too big to pass as one command-line argument).
autof() {
  out=$(wget -qO- --header "$H" --header "Content-Type: application/json" --post-file "$2" "$BASE$1" 2>"$ERRF")
  st=$?
  [ $st -eq 0 ] || { fail_hint $st; return $st; }
  case "$out" in '{"ok":false'*) printf '%s\n' "$out" >&2; return 1 ;; esac
  printf '%s\n' "$out"
}
# Positional arguments land in A1 A2; --timeout/--delay/--state/--shift and a few more in their own variables.
popts() {
  A1=; A2=; TIMEOUT=; DELAY=; STATE=; WAIT=; SHIFTK=; DOMAIN=; PATHV=; SECURE=; HTTPONLY=; SAMESITE=; EXPIRES=; MAXAGE=; OUTF=; DIR=; SEL=; FULL=; FMT=; COMPACT=; n=0; endopts=0
  while [ $# -gt 0 ]; do
    if [ $endopts -eq 0 ]; then
      case "$1" in
        --) endopts=1; shift; continue ;;
        --timeout) num "$2"; TIMEOUT=$2; shift 2; continue ;;
        --delay) num "$2"; DELAY=$2; shift 2; continue ;;
        --state) STATE=$2; shift 2; continue ;;
        --wait) WAIT=1; shift; continue ;;
        --no-wait) WAIT=0; shift; continue ;;
        --shift) SHIFTK=1; shift; continue ;;
        --domain) DOMAIN=$2; shift 2; continue ;;
        --path) PATHV=$2; shift 2; continue ;;
        --secure) SECURE=1; shift; continue ;;
        --httponly) HTTPONLY=1; shift; continue ;;
        --samesite) SAMESITE=$2; shift 2; continue ;;
        --expires) num "$2"; EXPIRES=$2; shift 2; continue ;;
        --max-age) num "$2"; MAXAGE=$2; shift 2; continue ;;
        --out) OUTF=$2; shift 2; continue ;;
        --dir) DIR=$2; shift 2; continue ;;
        --selector) SEL=$2; shift 2; continue ;;
        --full-page) FULL=1; shift; continue ;;
        --format) FMT=$2; shift 2; continue ;;
        --compact) COMPACT=1; shift; continue ;;
        --*) die "unknown option $1" ;;
      esac
    fi
    n=$((n+1))
    if [ $n -eq 1 ]; then A1=$1; elif [ $n -eq 2 ]; then A2=$1; else die "too many arguments"; fi
    shift
  done
}
# An element command: act <cmd> [selector] [text|name|key] [field]
act() {
  J="{\"cmd\":\"$1\",\"selector\":$(jstr "$2")"
  [ -n "$TIMEOUT" ] && J="$J,\"timeout\":$TIMEOUT"
  [ -n "$DELAY" ] && J="$J,\"delay\":$DELAY"
  [ -n "$STATE" ] && case "$STATE" in visible|hidden|attached) J="$J,\"state\":\"$STATE\"" ;; *) die "--state must be visible, hidden or attached" ;; esac
  [ -n "$4" ] && J="$J,\"$4\":$(jstr "$3")"   # the value may be empty (fill with "" clears a field)
  [ -n "$SHIFTK" ] && J="$J,\"shift\":true"
  auto "/act" "$J}"
}
# History filters as a query string.
hquery() {
  Q=
  while [ $# -gt 0 ]; do
    case "$1" in
      --host|--method|--status|--since|--limit|--page|--contains) safe "$2"; Q="$Q&${1#--}=$2"; shift 2 ;;
      --compact) Q="$Q&fmt=lines"; shift ;;
      --out) shift 2 ;;
      *) safe "$1"; Q="$Q&host=$1"; shift ;;
    esac
  done
  Q=${Q#&}
}

# ---- argument checks -----------------------------------------------------------------------------------------
# Anything that goes into a URL path/query is restricted to a safe alphabet; enums are matched exactly.
safe() { case "$1" in ''|*[!A-Za-z0-9._*:-]*) die "unsupported characters in '$1'" ;; esac; }

# Options shared by `resolve ... edit` and `resend`: --method --target --status --header 'N: v' (repeatable) --body TEXT.
# Sets O_METHOD O_TARGET O_STATUS O_BODY (text) and O_HDRS (a JSON array body, without brackets).
parse_opts() {
  O_METHOD=; O_TARGET=; O_STATUS=; O_BODY=; O_HDRS=; O_HAS_BODY=0
  while [ $# -gt 0 ]; do
    [ $# -ge 2 ] || die "option $1 needs a value"
    case "$1" in
      --method) O_METHOD=$2 ;;
      --target) O_TARGET=$2 ;;
      --status) case "$2" in ''|*[!0-9]*) die "--status takes a number" ;; esac; O_STATUS=$2 ;;
      --body)   command -v base64 >/dev/null 2>&1 || die "--body needs the base64 command"
                O_BODY=$2; O_HAS_BODY=1 ;;
      --header) case "$2" in *:*) ;; *) die "--header needs 'Name: value'" ;; esac
                hn=${2%%:*}; hv=${2#*:}; hv=${hv# }
                O_HDRS="$O_HDRS{\"name\":$(jstr "$hn"),\"value\":$(jstr "$hv")}," ;;
      *) die "unknown option $1" ;;
    esac
    shift 2
  done
}
b64() { printf '%s' "$1" | base64 | tr -d '\n'; }

case "$1" in
  ping)      get "/ping" ;;
  ca)        pem=$(ca_pem) || die "could not fetch the proxy CA — AlpBrowser may not be reachable (try: browserctl ping)"
             printf '%s\n' "$pem" ;;
  trust)     trust_ca ;;
  mode)      if [ -n "$2" ]; then
               case "$2" in bugbounty|webdev) post "/mode" "{\"mode\":\"$2\"}" ;; *) die "mode must be bugbounty or webdev" ;; esac
             else get "/mode"; fi ;;
  capture)   case "${2:-}" in
               '')  get "/capture" ;;
               on)  post "/capture" '{"enabled":true}' ;;
               off) post "/capture" '{"enabled":false}' ;;
               *)   die "usage: browserctl capture [on|off]" ;;
             esac ;;
  tabs)      get "/tabs" ;;
  tab)       case "$2" in
               new)    shift 2; w=true; u=; for a in "$@"; do case "$a" in --no-wait) w=false ;; *) u=$a ;; esac; done
                       post "/tabs" "{\"action\":\"new\",\"url\":$(jstr "$u"),\"wait\":$w}" ;;
               switch|close) case "$3" in ''|*[!0-9]*) die "usage: browserctl tab $2 <id>" ;; esac
                       post "/tabs" "{\"action\":\"$2\",\"id\":$3}" ;;
               *)      die "usage: browserctl tab new [url] | tab switch <id> | tab close <id>" ;;
             esac ;;
  navigate)  shift; popts "$@"; [ -n "$A1" ] || die "usage: browserctl navigate <url> [--wait] [--state S] [--timeout ms]"
             J="{\"url\":$(jstr "$A1")"
             [ "$WAIT" = 1 ] && J="$J,\"wait\":true"
             [ -n "$STATE" ] && case "$STATE" in load|domcontentloaded|networkidle) J="$J,\"state\":\"$STATE\"" ;; *) die "--state must be load, domcontentloaded or networkidle" ;; esac
             [ -n "$TIMEOUT" ] && J="$J,\"timeout\":$TIMEOUT"
             if [ "$WAIT" = 1 ]; then auto "/navigate" "$J}"; else post "/navigate" "$J}"; fi ;;
  waitnav)   shift; popts "$@"
             J="{\"state\":\"${STATE:-load}\""; [ -n "$TIMEOUT" ] && J="$J,\"timeout\":$TIMEOUT"
             auto "/waitnav" "$J}" ;;
  eval)      shift; src=; mode=arg; EX=; ev_done=0
             while [ $# -gt 0 ]; do
               case "$1" in
                 --file) [ -r "$2" ] || die "cannot read $2"; mode=file; src=$2; shift 2 ;;
                 --stdin) mode=stdin; shift ;;
                 --await) EX="$EX,\"await\":true"; shift ;;
                 --timeout) num "$2"; EX="$EX,\"timeout\":$2"; shift 2 ;;
                 *) [ "$ev_done" = 0 ] || die "too many arguments"; src=$1; ev_done=1; shift ;;
               esac
             done
             case "$mode" in
               file) body=$(cat "$src") ;;
               stdin) body=$(cat) ;;
               *) body=$src ;;
             esac
             [ -n "$body" ] || die "usage: browserctl eval '<js>' | --file <path> | --stdin"
             T=$(mktemp "${TMPDIR:-/tmp}/browserctl.XXXXXX") || die "cannot create a temporary file"
             { printf '{"js":'; jstr "$body"; printf '%s}' "$EX"; } > "$T"
             autof "/eval" "$T"; rc=$?; rm -f "${T:?}"; exit $rc ;;
  click)     shift; popts "$@"; [ -n "$A1" ] || die "usage: browserctl click <selector> [--timeout ms]"; act click "$A1" ;;
  fill)      shift; popts "$@"; [ -n "$A1" ] && [ "$n" -ge 2 ] || die "usage: browserctl fill <selector> <text> [--timeout ms]  (use '' to clear)"; act fill "$A1" "$A2" text ;;
  type)      shift; popts "$@"; [ -n "$A1" ] && [ "$n" -ge 2 ] || die "usage: browserctl type <selector> <text> [--delay ms]"; act type "$A1" "$A2" text ;;
  press)     shift; popts "$@"; [ -n "$A1" ] || die "usage: browserctl press <key>  (Enter, Tab, Escape, ...)"; act press "" "$A1" key ;;
  text)      shift; popts "$@"; [ -n "$A1" ] || die "usage: browserctl text <selector>"; act text "$A1" ;;
  attr)      shift; popts "$@"; [ -n "$A1" ] && [ -n "$A2" ] || die "usage: browserctl attr <selector> <name>"; act attr "$A1" "$A2" name ;;
  html)      shift; popts "$@"; act html "$A1" ;;
  waitfor)   shift; popts "$@"; [ -n "$A1" ] || die "usage: browserctl waitfor <selector> [--state visible|hidden|attached] [--timeout ms]"; act waitfor "$A1" ;;
  exists)    shift; popts "$@"; [ -n "$A1" ] || die "usage: browserctl exists <selector>"
             res=$(act exists "$A1") || exit 1
             printf '%s\n' "$res"
             case "$res" in *'"exists":true'*) exit 0 ;; *) exit 1 ;; esac ;;
  shot)      shift; popts "$@"
             fmt=${FMT:-png}; case "$fmt" in png|jpeg|jpg) ;; *) die "--format must be png or jpeg" ;; esac
             ext=$fmt; [ "$fmt" = jpeg ] && ext=jpg; target=${OUTF:-shot.$ext}
             q="format=$fmt"; [ -n "$SEL" ] && q="$q&selector=$(urlenc "$SEL")"; [ "$FULL" = 1 ] && q="$q&fullPage=1"
             wget -qO "$target" --header "$H" "$BASE/shot?$q" 2>"$ERRF"; st=$?
             [ $st -eq 0 ] || { rm -f "${target:?}"; fail_hint $st; exit $st; }
             case "$(head -c 12 "$target" 2>/dev/null | tr -d '\000')" in '{"ok":false'*) cat "$target" >&2; echo >&2; rm -f "${target:?}"; exit 1 ;; esac
             printf '{"ok":true,"path":%s,"bytes":%s}\n' "$(jstr "$target")" "$(wc -c < "$target" | tr -d ' ')" ;;
  cookies)   shift; popts "$@"; if [ -n "$DOMAIN" ]; then safe "$DOMAIN"; get "/cookies?domain=$DOMAIN"; else get "/cookies"; fi ;;
  setcookie) shift; popts "$@"; [ -n "$A1" ] || die "usage: browserctl setcookie <name> <value> [--domain d] [--path p] [--secure] [--httponly] [--samesite Lax|Strict|None] [--expires epoch-seconds] [--max-age seconds]"
             J="{\"name\":$(jstr "$A1"),\"value\":$(jstr "$A2")"
             [ -n "$DOMAIN" ] && J="$J,\"domain\":$(jstr "$DOMAIN")"; [ -n "$PATHV" ] && J="$J,\"path\":$(jstr "$PATHV")"
             [ -n "$SECURE" ] && J="$J,\"secure\":true"; [ -n "$HTTPONLY" ] && J="$J,\"httpOnly\":true"
             [ -n "$SAMESITE" ] && J="$J,\"sameSite\":$(jstr "$SAMESITE")"
             [ -n "$EXPIRES" ] && J="$J,\"expires\":$EXPIRES"; [ -n "$MAXAGE" ] && J="$J,\"maxAge\":$MAXAGE"
             auto "/cookies" "$J}" ;;
  cdp)       shift; port=; raw=0; off=0
             for a in "$@"; do case "$a" in off) off=1 ;; --json) raw=1 ;; *[!0-9]*|'') die "usage: browserctl cdp [port] | cdp off | cdp --json" ;; *) port=$a ;; esac; done
             if [ $off -eq 1 ]; then post "/cdp" '{"enabled":false}' >/dev/null; echo 0; exit 0; fi
             J='{"enabled":true'; [ -n "$port" ] && J="$J,\"port\":$port"
             res=$(wget -qO- --header "$H" --header "Content-Type: application/json" --post-data "$J}" "$BASE/cdp" 2>"$ERRF") || { fail_hint $?; exit 1; }
             [ $raw -eq 1 ] && { printf '%s\n' "$res"; exit 0; }
             url=$(printf '%s' "$res" | sed -n 's/.*"webSocketDebuggerUrl":"\([^"]*\)".*/\1/p' | sed 's#\\/#/#g')
             if [ -n "$url" ]; then printf '%s\n' "$url"; else echo 0; printf '%s\n' "$res" >&2; exit 1; fi ;;
  save)      shift; popts "$@"; safe "$A1"
             if [ -n "$DIR" ]; then
               mkdir -p "$DIR" || die "cannot create $DIR"
               for part in request response meta; do
                 f=$part.txt; [ $part = meta ] && f=meta.json
                 wget -qO "$DIR/$f" --header "$H" "$BASE/history/$A1/$part" 2>"$ERRF" || { fail_hint $?; exit 1; }
               done
               for part in request response; do
                 wget -qO "$DIR/$part.body" --header "$H" "$BASE/history/$A1/body/$part" 2>"$ERRF" || { fail_hint $?; exit 1; }
                 [ -s "$DIR/$part.body" ] || rm -f "${DIR:?}/${part:?}.body"
               done
               printf '{"ok":true,"dir":%s}\n' "$(jstr "$DIR")"
             elif [ -n "$OUTF" ]; then
               { wget -qO- --header "$H" "$BASE/history/$A1/request" 2>"$ERRF" && printf '\n\n' && wget -qO- --header "$H" "$BASE/history/$A1/response" 2>"$ERRF"; } > "$OUTF" || { rm -f "${OUTF:?}"; fail_hint $?; exit 1; }
               printf '{"ok":true,"path":%s}\n' "$(jstr "$OUTF")"
             else die "usage: browserctl save <id> --dir <dir> | --out <file>"; fi ;;
  har)       shift; OUTF=; rest=
             while [ $# -gt 0 ]; do case "$1" in --out) OUTF=$2; shift 2 ;; *) rest="$rest $1"; shift ;; esac; done
             set -f; set -- $rest; set +f; hquery "$@"
             if [ -n "$OUTF" ]; then
               wget -qO "$OUTF" --header "$H" "$BASE/har?$Q" 2>"$ERRF" || { rm -f "${OUTF:?}"; fail_hint $?; exit 1; }
               printf '{"ok":true,"path":%s,"bytes":%s}\n' "$(jstr "$OUTF")" "$(wc -c < "$OUTF" | tr -d ' ')"
             else wget -qO- --header "$H" "$BASE/har?$Q" 2>"$ERRF" || { fail_hint $?; exit 1; }; echo; fi ;;
  clear)     case "${2:-all}" in cookies|cache|storage|all) post "/clear" "{\"what\":\"${2:-all}\"}" ;; *) die "clear takes cookies|cache|storage|all" ;; esac ;;
  history)   shift; hquery "$@"
             if [ -n "$Q" ]; then get "/history?$Q"; else get "/history"; fi ;;
  get)       safe "$2"; get "/history/$2" ;;
  frames)    shift; safe "${1:-}"; fid=$1; shift; fq=
             while [ $# -gt 0 ]; do
               case "$1" in
                 --from) num "$2"; fq="$fq&from=$2"; shift 2 ;;
                 --limit) num "$2"; fq="$fq&limit=$2"; shift 2 ;;
                 --compact) fq="$fq&fmt=lines"; shift ;;
                 *) die "usage: browserctl frames <id> [--from n] [--limit n] [--compact]" ;;
               esac
             done
             get "/frames/$fid?${fq#&}" ;;
  scope)     if [ -n "$2" ]; then P=""; shift; for p in "$@"; do P="$P$(jstr "$p"),"; done; post "/scope" "{\"patterns\":[${P%,}]}"; else get "/scope"; fi ;;
  intercept) case "$2" in
               on)  shift 2; ihost=; iresp=false; iskip=true
                    for a in "$@"; do
                      case "$a" in --responses) iresp=true ;; --all-assets) iskip=false ;; -*) die "unknown option $a" ;; *) ihost=$a ;; esac
                    done
                    post "/intercept" "{\"enabled\":true,\"hostFilter\":$(jstr "$ihost"),\"responses\":$iresp,\"skipStatic\":$iskip}" ;;
               off) post "/intercept" "{\"enabled\":false}" ;;
               *)   die "usage: browserctl intercept on [hostFilter] [--responses] [--all-assets] | intercept off" ;;
             esac ;;
  pending)   get "/intercept" ;;
  resolve)   [ -n "$2" ] || die "usage: browserctl resolve <holdId> [forward|drop|edit ...]"
             case "${3:-forward}" in
               forward|drop) post "/intercept/resolve" "{\"holdId\":$(jstr "$2"),\"action\":\"${3:-forward}\"}" ;;
               edit) id=$2; shift 3; parse_opts "$@"
                     J="{\"holdId\":$(jstr "$id"),\"action\":\"edit\""
                     [ -n "$O_METHOD" ] && J="$J,\"method\":$(jstr "$O_METHOD")"
                     [ -n "$O_TARGET" ] && J="$J,\"target\":$(jstr "$O_TARGET")"
                     [ -n "$O_STATUS" ] && J="$J,\"status\":$O_STATUS"
                     [ -n "$O_HDRS" ] && J="$J,\"setHeaders\":[${O_HDRS%,}]"
                     [ "$O_HAS_BODY" = 1 ] && J="$J,\"body\":\"$(b64 "$O_BODY")\""
                     post "/intercept/resolve" "$J}" ;;
               *) die "action must be forward, drop or edit" ;;
             esac ;;
  resend)    case "$2" in ''|*[!A-Za-z]*) die "usage: browserctl resend <METHOD> <url> [--header 'N: v']... [--body TEXT]" ;; esac
             case "$3" in http://*|https://*) ;; *) die "resend needs an http:// or https:// url" ;; esac
             m=$2; u=$3; shift 3; parse_opts "$@"
             J="{\"method\":$(jstr "$m"),\"url\":$(jstr "$u"),\"headers\":[${O_HDRS%,}]"
             [ "$O_HAS_BODY" = 1 ] && J="$J,\"body\":\"$(b64 "$O_BODY")\""
             post "/resend" "$J}" ;;
  rule)      case "$2" in
               add) case "$3" in REQ_HEADER|REQ_BODY|RES_HEADER|RES_BODY) ;; *) die "part must be REQ_HEADER, REQ_BODY, RES_HEADER or RES_BODY" ;; esac
                    post "/rules" "{\"part\":\"$3\",\"find\":$(jstr "$4"),\"replace\":$(jstr "$5"),\"hostContains\":$(jstr "${6:-}")}" ;;
               header) case "$3" in req) part=REQ_HEADER ;; res) part=RES_HEADER ;; *) die "usage: browserctl rule header <req|res> 'Name: value' [host]" ;; esac
                       case "$4" in *:*) ;; *) die "give the header as 'Name: value'" ;; esac
                       post "/rules" "{\"part\":\"$part\",\"find\":\"\",\"replace\":$(jstr "$4"),\"hostContains\":$(jstr "${5:-}")}" ;;
               del) [ -n "$3" ] || die "usage: browserctl rule del <id>"
                    post "/rules/delete" "{\"id\":$(jstr "$3")}" ;;
               *)   die "usage: browserctl rule add <PART> <find> <replace> [host] | rule header <req|res> 'Name: value' [host] | rule del <id>" ;;
             esac ;;
  rules)     get "/rules" ;;
  console)   case "${2:-200}" in ''|*[!0-9]*) die "console takes a number" ;; esac
             get "/console?limit=${2:-200}" ;;
  *) echo "usage: browserctl {ping|ca|trust|mode|capture|tabs|tab|navigate|waitnav|click|fill|type|press|text|attr|exists|html|waitfor|shot|cookies|setcookie|cdp|save|har|eval|clear|history|get|scope|intercept|pending|resolve|resend|rule|rules|console}" >&2; exit 2 ;;
esac

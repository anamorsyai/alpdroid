#!/bin/sh
# browserctl — drive AlpBrowser from the AlpDroid agent's Alpine shell (control API on 127.0.0.1, reachable from proot).
# AlpDroid installs this and provisions the token automatically (read from AlpBrowser over a signed channel), so you
# normally just run `browserctl ping`. If it says AlpBrowser is not linked, open the AlpBrowser app once, then start a
# new shell (or retry).
#
# General:   ping | ca | trust | mode [bugbounty|webdev] | navigate <url> | eval '<js>' | clear [cookies|cache|storage|all]
# Capture:   capture [on|off]     route the page through the proxy (needed for decrypted History); off = fast direct browsing
# Tabs:      tabs | tab new [url] | tab switch <id> | tab close <id>
# History:   history [host] | get <id>
# Bug bounty: scope [<pattern> ...] | intercept on [hostFilter] [--responses] [--all-assets] | intercept off | pending | resolve <holdId> [forward|drop]
#             resolve <holdId> edit [--method M] [--target PATH] [--status N] [--header 'Name: v']... [--body TEXT]
#             rule add <REQ_HEADER|REQ_BODY|RES_HEADER|RES_BODY> <find> <replace> [host] | rules | rule del <id>
#             rule header <req|res> 'Name: value' [host]      set/add a header on all matching traffic
# Repeater:  resend <METHOD> <url> [--header 'Name: v']... [--body TEXT]   re-send a request, print the response
# Web dev:   console [limit]
#
# Every command's real exit status reflects whether the HTTP call actually succeeded — never trust a printed
# "ok"-looking message over the exit code (`browserctl ping || echo unreachable`).

# ---- connection details --------------------------------------------------------------------------------------
# The token/port come from AlpBrowser via AlpDroid, in a file refreshed on every session start. It is PARSED, never
# sourced: the file lives in the guest where any program can write it, and sourcing it would run whatever it holds.
ENVFILE="${BROWSERCTL_ENV:-/etc/alpdroid/alpbrowser.env}"
if [ -z "${ALPBROWSER_TOKEN:-}" ] && [ -r "$ENVFILE" ]; then
  while IFS='=' read -r k v; do
    case "$k" in
      ALPBROWSER_TOKEN) ALPBROWSER_TOKEN=$v ;;
      ALPBROWSER_PORT)  [ -z "${ALPBROWSER_PORT:-}" ] && ALPBROWSER_PORT=$v ;;
    esac
  done < "$ENVFILE"
fi
TOK="${ALPBROWSER_TOKEN:-}"
PORT="${ALPBROWSER_PORT:-8899}"
if [ -z "$TOK" ]; then
  echo "AlpBrowser is not linked yet. Install it from AlpDroid → Settings → About → AlpBrowser, open it once, then start a new shell." >&2
  exit 3
fi
# Only a plain token and a plain port ever reach a URL or header.
case "$TOK" in *[!A-Za-z0-9]*) echo "browserctl: the AlpBrowser token looks malformed" >&2; exit 3 ;; esac
case "$PORT" in ''|*[!0-9]*) echo "browserctl: the AlpBrowser port looks malformed" >&2; exit 3 ;; esac
BASE="http://127.0.0.1:$PORT/v1"
H="Authorization: Bearer $TOK"

die() { echo "browserctl: $*" >&2; exit 2; }

# ---- HTTP ----------------------------------------------------------------------------------------------------
# wget's own exit status is preserved and returned (the trailing `echo` that gives a readable trailing newline
# would otherwise reset $? to 0 on every call, silently turning every failed request into an apparent success).
fail_hint() { echo "browserctl: request failed (exit $1) — is AlpBrowser open and linked? try: browserctl ping" >&2; }
get() {
  wget -qO- --header "$H" "$BASE$1" 2>/dev/null
  st=$?
  [ $st -eq 0 ] && echo || fail_hint $st
  return $st
}
post() {
  wget -qO- --header "$H" --header "Content-Type: application/json" --post-data "$2" "$BASE$1" 2>/dev/null
  st=$?
  [ $st -eq 0 ] && echo || fail_hint $st
  return $st
}

# ---- JSON ----------------------------------------------------------------------------------------------------
# A JSON string literal for ANY text — empty, multi-line, with tabs, quotes or backslashes. The whole input is
# slurped into one pattern space first, so a newline becomes \n instead of closing and reopening the string.
# `$!N` (append the next line only when there IS one) matters: a bare `N` on the last line makes busybox sed quit
# without running the substitutions, so every single-line argument came out unquoted and unescaped.
TAB=$(printf '\t')
CR=$(printf '\r')
jstr() {
  [ -z "$1" ] && { printf '""'; return; }
  printf '%s' "$1" | tr -d '\000-\010\013\014\016-\037' | sed -e ':a' -e '$!N' -e '$!ba' \
    -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e "s/$TAB/\\\\t/g" -e "s/$CR/\\\\r/g" -e 's/\n/\\n/g' \
    -e 's/^/"/' -e 's/$/"/'
}

# ---- CA ------------------------------------------------------------------------------------------------------
# The control API returns the PEM inside a JSON string. Android's org.json escapes EVERY "/" as "\/" (and base64
# is full of them), so undo "\/" as well as "\n" — leaving "\/" in would silently corrupt the certificate.
ca_pem() {
  raw=$(wget -qO- --header "$H" "$BASE/ca" 2>/dev/null) || return 1
  printf '%s' "$raw" | sed -n 's/.*"pem":"\([^"]*\)".*/\1/p' | sed -e 's#\\/#/#g' -e 's/\\n/\
/g'
}
# A structurally sound PEM certificate and nothing else: BEGIN/END markers and base64 lines in between.
valid_pem() {
  case "$1" in *"-----BEGIN CERTIFICATE-----"*"-----END CERTIFICATE-----"*) ;; *) return 1 ;; esac
  printf '%s\n' "$1" | grep -v -e '^-----BEGIN CERTIFICATE-----$' -e '^-----END CERTIFICATE-----$' -e '^[A-Za-z0-9+/=]*$' >/dev/null && return 1
  return 0
}
BUNDLE="${BROWSERCTL_BUNDLE:-/etc/ssl/certs/ca-certificates.crt}"
CADIR="${BROWSERCTL_CADIR:-/usr/local/share/ca-certificates}"
trust_ca() {
  pem=$(ca_pem) || die "could not fetch the proxy CA — AlpBrowser may not be reachable (try: browserctl ping)"
  valid_pem "$pem" || die "AlpBrowser did not return a valid CA certificate — nothing was changed"
  if command -v update-ca-certificates >/dev/null 2>&1; then
    # The proper route: survives `apk upgrade ca-certificates`, which regenerates the bundle and would drop an appended cert.
    mkdir -p "$CADIR" || die "cannot create $CADIR"
    printf '%s\n' "$pem" > "$CADIR/alpbrowser.crt" || die "cannot write the CA file"
    update-ca-certificates >/dev/null 2>&1 || die "update-ca-certificates failed"
    echo "CA installed (update-ca-certificates)"
    return 0
  fi
  # Minimal Alpine (no update-ca-certificates): append to the bundle, once. Already present = nothing to do.
  first=$(printf '%s\n' "$pem" | sed -n '2p')
  if [ -f "$BUNDLE" ] && grep -qxF -- "$first" "$BUNDLE" 2>/dev/null; then
    echo "CA already trusted"
    return 0
  fi
  printf '%s\n' "$pem" >> "$BUNDLE" || die "cannot write $BUNDLE"
  echo "CA appended to the Alpine bundle"
}

# ---- argument checks -----------------------------------------------------------------------------------------
# Anything that goes into a URL path/query is restricted to a safe alphabet; enums are matched exactly.
safe() { case "$1" in ''|*[!A-Za-z0-9._*:-]*) die "unsupported characters in '$1'" ;; esac; }

# Options shared by `resolve ... edit` and `resend`: --method --target --status --header 'N: v' (repeatable) --body TEXT.
# Sets O_METHOD O_TARGET O_STATUS O_BODY (text) and O_HDRS (a JSON array body, without brackets).
parse_opts() {
  O_METHOD=; O_TARGET=; O_STATUS=; O_BODY=; O_HDRS=; O_HAS_BODY=0
  while [ $# -gt 0 ]; do
    [ $# -ge 2 ] || die "option $1 needs a value"
    case "$1" in
      --method) O_METHOD=$2 ;;
      --target) O_TARGET=$2 ;;
      --status) case "$2" in ''|*[!0-9]*) die "--status takes a number" ;; esac; O_STATUS=$2 ;;
      --body)   command -v base64 >/dev/null 2>&1 || die "--body needs the base64 command"
                O_BODY=$2; O_HAS_BODY=1 ;;
      --header) case "$2" in *:*) ;; *) die "--header needs 'Name: value'" ;; esac
                hn=${2%%:*}; hv=${2#*:}; hv=${hv# }
                O_HDRS="$O_HDRS{\"name\":$(jstr "$hn"),\"value\":$(jstr "$hv")}," ;;
      *) die "unknown option $1" ;;
    esac
    shift 2
  done
}
b64() { printf '%s' "$1" | base64 | tr -d '\n'; }

case "$1" in
  ping)      get "/ping" ;;
  ca)        pem=$(ca_pem) || die "could not fetch the proxy CA — AlpBrowser may not be reachable (try: browserctl ping)"
             printf '%s\n' "$pem" ;;
  trust)     trust_ca ;;
  mode)      if [ -n "$2" ]; then
               case "$2" in bugbounty|webdev) post "/mode" "{\"mode\":\"$2\"}" ;; *) die "mode must be bugbounty or webdev" ;; esac
             else get "/mode"; fi ;;
  capture)   case "${2:-}" in
               '')  get "/capture" ;;
               on)  post "/capture" '{"enabled":true}' ;;
               off) post "/capture" '{"enabled":false}' ;;
               *)   die "usage: browserctl capture [on|off]" ;;
             esac ;;
  tabs)      get "/tabs" ;;
  tab)       case "$2" in
               new)    post "/tabs" "{\"action\":\"new\",\"url\":$(jstr "${3:-}")}" ;;
               switch|close) case "$3" in ''|*[!0-9]*) die "usage: browserctl tab $2 <id>" ;; esac
                       post "/tabs" "{\"action\":\"$2\",\"id\":$3}" ;;
               *)      die "usage: browserctl tab new [url] | tab switch <id> | tab close <id>" ;;
             esac ;;
  navigate)  [ -n "$2" ] || die "usage: browserctl navigate <url>"
             post "/navigate" "{\"url\":$(jstr "$2")}" ;;
  eval)      [ -n "$2" ] || die "usage: browserctl eval '<js>'"
             post "/eval" "{\"js\":$(jstr "$2")}" ;;
  clear)     case "${2:-all}" in cookies|cache|storage|all) post "/clear" "{\"what\":\"${2:-all}\"}" ;; *) die "clear takes cookies|cache|storage|all" ;; esac ;;
  history)   if [ -n "$2" ]; then safe "$2"; get "/history?host=$2"; else get "/history"; fi ;;
  get)       safe "$2"; get "/history/$2" ;;
  scope)     if [ -n "$2" ]; then P=""; shift; for p in "$@"; do P="$P$(jstr "$p"),"; done; post "/scope" "{\"patterns\":[${P%,}]}"; else get "/scope"; fi ;;
  intercept) case "$2" in
               on)  shift 2; ihost=; iresp=false; iskip=true
                    for a in "$@"; do
                      case "$a" in --responses) iresp=true ;; --all-assets) iskip=false ;; -*) die "unknown option $a" ;; *) ihost=$a ;; esac
                    done
                    post "/intercept" "{\"enabled\":true,\"hostFilter\":$(jstr "$ihost"),\"responses\":$iresp,\"skipStatic\":$iskip}" ;;
               off) post "/intercept" "{\"enabled\":false}" ;;
               *)   die "usage: browserctl intercept on [hostFilter] [--responses] [--all-assets] | intercept off" ;;
             esac ;;
  pending)   get "/intercept" ;;
  resolve)   [ -n "$2" ] || die "usage: browserctl resolve <holdId> [forward|drop|edit ...]"
             case "${3:-forward}" in
               forward|drop) post "/intercept/resolve" "{\"holdId\":$(jstr "$2"),\"action\":\"${3:-forward}\"}" ;;
               edit) id=$2; shift 3; parse_opts "$@"
                     J="{\"holdId\":$(jstr "$id"),\"action\":\"edit\""
                     [ -n "$O_METHOD" ] && J="$J,\"method\":$(jstr "$O_METHOD")"
                     [ -n "$O_TARGET" ] && J="$J,\"target\":$(jstr "$O_TARGET")"
                     [ -n "$O_STATUS" ] && J="$J,\"status\":$O_STATUS"
                     [ -n "$O_HDRS" ] && J="$J,\"setHeaders\":[${O_HDRS%,}]"
                     [ "$O_HAS_BODY" = 1 ] && J="$J,\"body\":\"$(b64 "$O_BODY")\""
                     post "/intercept/resolve" "$J}" ;;
               *) die "action must be forward, drop or edit" ;;
             esac ;;
  resend)    case "$2" in ''|*[!A-Za-z]*) die "usage: browserctl resend <METHOD> <url> [--header 'N: v']... [--body TEXT]" ;; esac
             case "$3" in http://*|https://*) ;; *) die "resend needs an http:// or https:// url" ;; esac
             m=$2; u=$3; shift 3; parse_opts "$@"
             J="{\"method\":$(jstr "$m"),\"url\":$(jstr "$u"),\"headers\":[${O_HDRS%,}]"
             [ "$O_HAS_BODY" = 1 ] && J="$J,\"body\":\"$(b64 "$O_BODY")\""
             post "/resend" "$J}" ;;
  rule)      case "$2" in
               add) case "$3" in REQ_HEADER|REQ_BODY|RES_HEADER|RES_BODY) ;; *) die "part must be REQ_HEADER, REQ_BODY, RES_HEADER or RES_BODY" ;; esac
                    post "/rules" "{\"part\":\"$3\",\"find\":$(jstr "$4"),\"replace\":$(jstr "$5"),\"hostContains\":$(jstr "${6:-}")}" ;;
               header) case "$3" in req) part=REQ_HEADER ;; res) part=RES_HEADER ;; *) die "usage: browserctl rule header <req|res> 'Name: value' [host]" ;; esac
                       case "$4" in *:*) ;; *) die "give the header as 'Name: value'" ;; esac
                       post "/rules" "{\"part\":\"$part\",\"find\":\"\",\"replace\":$(jstr "$4"),\"hostContains\":$(jstr "${5:-}")}" ;;
               del) [ -n "$3" ] || die "usage: browserctl rule del <id>"
                    post "/rules/delete" "{\"id\":$(jstr "$3")}" ;;
               *)   die "usage: browserctl rule add <PART> <find> <replace> [host] | rule header <req|res> 'Name: value' [host] | rule del <id>" ;;
             esac ;;
  rules)     get "/rules" ;;
  console)   case "${2:-200}" in ''|*[!0-9]*) die "console takes a number" ;; esac
             get "/console?limit=${2:-200}" ;;
  *) echo "usage: browserctl {ping|ca|trust|mode|capture|tabs|tab|navigate|eval|clear|history|get|scope|intercept|pending|resolve|resend|rule|rules|console}" >&2; exit 2 ;;
esac

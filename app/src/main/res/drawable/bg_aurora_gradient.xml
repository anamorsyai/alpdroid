<?xml version="1.0" encoding="utf-8"?>
<!-- Aurora gradient — teal to violet, used sparingly: the active tab, primary actions and
     the setup progress fill. Never behind body text. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="45"
        android:startColor="@color/aurora_gradient_start"
        android:endColor="@color/aurora_gradient_end"
        android:type="linear" />
    <corners android:radius="999dp" />
</shape>

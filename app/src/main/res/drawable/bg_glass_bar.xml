<?xml version="1.0" encoding="utf-8"?>
<!-- Aurora Glass floating bar — the rounded glass container behind the tab bar and the
     extra-keys row. A translucent panel with a hairline stroke reads as floating over the
     terminal without hiding it, and costs one shape draw (no blur, so no frame cost). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/glass_surface" />
    <stroke
        android:width="1dp"
        android:color="@color/glass_stroke" />
    <corners android:radius="20dp" />
</shape>

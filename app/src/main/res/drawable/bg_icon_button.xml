<?xml version="1.0" encoding="utf-8"?>
<!-- Ripple over a rounded tonal surface — the redesign's standard icon-button background,
     replacing plain unstyled Buttons/ImageButtons everywhere they show up. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/panel_3" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</ripple>
